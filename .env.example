# Supabase-Zugang fürs Frontend. Kopiere diese Datei nach `.env` und trage die Werte ein.
# Beide Werte stehen im Supabase-Dashboard unter: Project Settings -> API.
# NUR den anon/publishable Key verwenden — der service_role/secret Key gehört NIEMALS ins Frontend.

VITE_SUPABASE_URL=https://DEINPROJEKT.supabase.co
VITE_SUPABASE_ANON_KEY=DEIN_ANON_PUBLISHABLE_KEY

# Ohne diese Werte läuft die App lokal (IndexedDB-only), ohne Cloud-Sync und ohne Login.
